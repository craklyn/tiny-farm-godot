# Replacement for the user-installed tiny-farm-hq.service at the convergence
# cutover. Do not enable beside the old unit: install under the same unit name
# only after the old process is stopped and its unit file is backed up.
[Unit]
Description=Tiny Farm HQ (single live data store on localhost:8642)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/daniel/dev/tiny-farm-godot-main
Environment=PATH=/home/daniel/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin
Environment=HQ_REQUIRE_EXPLICIT_ROOTS=1
Environment=HQ_DATA_ROOT=/home/daniel/tiny-farm-hq-data
Environment=HQ_USER_WORKSPACE_ROOT=/home/daniel/dev/tiny-farm-godot
Environment=HQ_MAIN_ROOT=/home/daniel/dev/tiny-farm-godot-main
ExecStart=/usr/bin/python3 /home/daniel/dev/tiny-farm-godot-main/hq/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
