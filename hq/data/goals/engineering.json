    {
      "id": "determinism-invariants",
      "statement": "The rules that keep replays reproducible still hold in the code.",
      "statement_short": "a rule that keeps replays reproducible is broken in the code",
      "owner": "elena",
      "severity": "blocking",
      "unit": "rules",
      "why_it_matters": "Recorded sessions are the training data phase 4 runs on. A break here is silent until bot training fails, which is the worst possible time to find out.",
      "measure": {
        "kind": "composite",
        "op": "all_of",
        "label": "three determinism rules",
        "members": [
          {
            "kind": "file_grep",
            "label": "no raw randomness outside the two sanctioned generators",
            "paths": [
              "systems/",
              "world/",
              "entities/",
              "player/",
              "crops/",
              "autoload/",
              "ui/",
              "effects/"
            ],
            "exclude_paths": [
              "systems/sim_rng.gd",
              "systems/cosmetic_rng.gd"
            ],
            "exts": [
              ".gd"
            ],
            "skip_comments": true,
            "pattern": "(?<![.\\w])(randi|randf|randi_range|randf_range)\\s*\\(",
            "expect": "absent",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          },
          {
            "kind": "file_grep",
            "label": "the sim layer touches no node, autoload or input",
            "paths": [
              "systems/sim/"
            ],
            "exts": [
              ".gd"
            ],
            "skip_comments": true,
            "pattern": "extends Node|get_tree\\(|Input\\.|preload\\(\"res://(ui|effects|world)",
            "expect": "absent",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          },
          {
            "kind": "gateway_rule",
            "label": "one gateway for every world change",
            "checker": "tools/check_gateway.py",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          }
        ]
      },
      "compare": {
        "direction": "must_be_true"
      },
      "path_to_green": {
        "narrative": "Run `python3 tools/check_gateway.py` — a broken rule names the line that broke it, and what the line should have done instead.",
        "route": {
          "kind": "none"
        },
        "owner": "elena"
      },
      "history": {
        "record": true,
        "chart": false
      }
