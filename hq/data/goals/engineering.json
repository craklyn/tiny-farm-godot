{
  "pillar": "engineering",
  "note": "Goal statements and targets are AUTHORED — a commitment cannot be derived. Every current value is MEASURED by hq/server.py's evaluator. A goal nothing can measure says so and counts against this pillar's assurance fraction.",
  "verdict_template": {
    "fire": "{worst}",
    "attention": "{worst}",
    "unassured": "Nothing is failing; monitoring is still landing on {unassured} of {total} areas, and the plans are filed.",
    "ok": "Green on main, and the test runs are recent enough to believe.",
    "dormant": "Dormant. {dormant_reason}",
    "nothing_for_you": "Nothing here needs you. {ours_line}"
  },
  "goals": [
    {
      "id": "games-deterministically-replayable",
      "statement": "Games deterministically replayable",
      "owner": "vp-engineering",
      "severity": "blocking",
      "unit": "rules",
      "why_it_matters": "Recorded games are the training data phase 4 runs on. A break here is silent until bot training fails, which is the worst possible time to find out.",
      "measure": {
        "kind": "composite",
        "op": "all_of",
        "label": "the rules that keep a replay reproducible, and whether the recorded games still replay",
        "members": [
          {
            "kind": "file_grep",
            "label": "no raw randomness outside the two sanctioned generators",
            "paths": [
              "systems/",
              "world/",
              "entities/",
              "player/",
              "crops/",
              "autoload/",
              "ui/",
              "effects/"
            ],
            "exclude_paths": [
              "systems/sim_rng.gd",
              "systems/cosmetic_rng.gd"
            ],
            "exts": [
              ".gd"
            ],
            "skip_comments": true,
            "pattern": "(?<![.\\w])(randi|randf|randi_range|randf_range)\\s*\\(",
            "expect": "absent",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          },
          {
            "kind": "file_grep",
            "label": "the sim layer touches no node, autoload or input",
            "paths": [
              "systems/sim/"
            ],
            "exts": [
              ".gd"
            ],
            "skip_comments": true,
            "pattern": "extends Node|get_tree\\(|Input\\.|preload\\(\"res://(ui|effects|world)",
            "expect": "absent",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          },
          {
            "kind": "gateway_rule",
            "label": "one gateway for every world change",
            "checker": "tools/check_gateway.py",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          },
          {
            "kind": "playtest_metric",
            "select": "all_with_trace",
            "metric": "build_resolvable_ratio",
            "label": "recorded games that can still be tied to the build that made them",
            "compare": {
              "direction": "higher_is_better",
              "target": 1.0
            }
          }
        ]
      },
      "compare": {
        "direction": "must_be_true"
      },
      "path_to_green": {
        "narrative": "Run `python3 tools/check_gateway.py` — a broken rule names the line that broke it, and what the line should have done instead.",
        "route": {
          "kind": "none"
        },
        "owner": "vp-engineering"
      },
      "history": {
        "record": true,
        "chart": false
      }
    },
    {
      "id": "build-branch-builds-green",
      "statement": "Build branch builds green",
      "statement_short": "Build fails either do to code/syntax errors or due to failures in the test suite.",
      "owner": "vp-engineering",
      "severity": "blocking",
      "unit": "state",
      "why_it_matters": "Builds failing blocks us releasing.",
      "measure": {
        "kind": "ci_state",
        "field": "newest_completed"
      },
      "path_to_green": {
        "narrative": "",
        "owner": "vp-engineering"
      },
      "history": {
        "record": false,
        "chart": false
      },
      "compare": {
        "direction": "in_set",
        "green_set": [
          "success"
        ],
        "unknown_set": [
          "in_progress"
        ]
      }
    },
    {
      "id": "automatic-release-pipeline",
      "statement": "Automatic release pipeline",
      "owner": "vp-engineering",
      "severity": "important",
      "unit": "",
      "why_it_matters": "Shipping should happen on its own when the conditions hold, rather than being a ritual you perform. Your judgement belongs in the standing policy — ship whenever these things are true — and the pipeline should carry it from there, all the way to players. Every step that still waits on a person is a step that will be forgotten, delayed, or done at midnight.",
      "measure": {
        "kind": "composite",
        "op": "all_of",
        "label": "what a tag does on its own, from build to the page a player lands on",
        "members": [
          {
            "kind": "file_grep",
            "label": "a tag publishes the build to the storefront with no hand on it",
            "paths": [
              ".github/workflows/release.yml"
            ],
            "exts": [
              ".yml"
            ],
            "pattern": "butler push",
            "expect": "present",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          },
          {
            "kind": "file_grep",
            "label": "the release updates the store page rather than a person doing it",
            "paths": [
              ".github/workflows/release.yml"
            ],
            "exts": [
              ".yml"
            ],
            "pattern": "ITCH_PAGE",
            "expect": "present",
            "field": "bool",
            "compare": {
              "direction": "must_be_true"
            }
          }
        ]
      },
      "compare": {
        "direction": "must_be_true"
      },
      "path_to_green": {
        "narrative": "Teach the release workflow to publish the page copy in ITCH_PAGE.md alongside the build.",
        "route": {
          "kind": "none"
        },
        "owner": "vp-engineering"
      },
      "history": {
        "record": false,
        "chart": false
      }
    }
  ],
  "scoreboard_title": "Where my areas stand"
}
