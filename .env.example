# Tiny Farm — credential names only. Copy to .env and fill in the values.
# .env is gitignored and must stay that way; nothing in this file is a secret.
#
# Where each one is used:
#   RETRODIFFUSION_API_KEY  the pixel-art pipeline (the retro-diffusion-pixel-art
#                           skill). Paid per generation; the balance is what
#                           Finance & Ops reports. https://retrodiffusion.ai
#   FREESOUND_API_KEY       sound-effect search for the audio bench.
#                           https://freesound.org/apiv2/apply
#
# Keep credentials in this project-local .env, never in a global ~/.env.

RETRODIFFUSION_API_KEY=
FREESOUND_API_KEY=
