# Godot editor cache (never commit; .import metadata files ARE committed)
.godot/

# Android build outputs (restored from upstream .gitignore)
android/build/

# Export artifacts
build/

# Local secrets (API keys) — never commit
.env
# retrodiff.env held the Retro Diffusion key in plaintext and was tracked from
# 118a780 until 2026-08-29. The key lives in .env only now; this line is
# belt-and-braces so a stray local copy can never be re-added.
retrodiff.env

# OS noise
.DS_Store

# Local review/scratch artifacts
diff.txt
diff_2.txt
*.patch
tools/diff_current.png

# Autotile preview output (regenerate with tools/tile_preview.tscn)
tools/tile_preview.png

# SFX preview render (regenerate with tools/gen_sfx.py --preview)
tools/sfx_preview.png

# Look-session captures (Q-86). Regenerate with tools/capture_looks.tscn and
# tools/compose_look_sheets.py; a sheet is committed only when it is attached to
# a decision card.
tools/looks/

# Last wireless-debugging address used by tools/deploy_android.sh
.adb_target
